<% layout("/layouts/boilerplate") %>

<script>
    const mapToken = "<%= mapToken %>";
    const coordinates = <%- JSON.stringify(listing.geometry.coordinates) %>;
    const listingTitle = <%- JSON.stringify(listing.title) %>;
</script>

<div class="container mt-4 mb-5">

    <!-- Property Header -->
    <div class="property-header mb-4">
        <div>
            <p class="text-success fw-bold mb-2">STAYSCAPE PROPERTY</p>
            <h2 class="fw-bold mb-2"><%= listing.title %></h2>
            <p class="text-muted mb-0">
                <i class="fa-solid fa-location-dot text-danger me-2"></i>
                <%= listing.location %>, <%= listing.country %>
            </p>
        </div>

        <% if(currUser && listing.owner._id.equals(currUser._id)) { %>
            <div class="owner-actions">
                <a href="/listings/<%= listing._id %>/edit"
                   class="btn btn-outline-success rounded-pill px-4">
                    <i class="fa-solid fa-pen me-2"></i>Edit
                </a>

                <form method="POST"
                      action="/listings/<%= listing._id %>?_method=DELETE"
                      onsubmit="return confirm('Are you sure you want to delete this property?');">
                    <button class="btn btn-outline-danger rounded-pill px-4">
                        <i class="fa-solid fa-trash me-2"></i>Delete
                    </button>
                </form>
            </div>
        <% } %>
    </div>

    <!-- Property Image -->
    <div class="property-image-container mb-4">
        <img src="<%= listing.image.url %>"
             class="property-main-image"
             alt="<%= listing.title %>">
    </div>

    <!-- Property Information -->
    <div class="row g-4">

        <div class="col-lg-8">

            <div class="property-info-card p-4 mb-4">

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
                    <div>
                        <h4 class="fw-bold mb-1">
                            Entire property hosted by
                            <%= listing.owner.username %>
                        </h4>
                        <p class="text-muted mb-0">
                            <i class="fa-solid fa-house me-2"></i>
                            Your comfortable stay awaits
                        </p>
                    </div>

                    <div class="host-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>
                </div>

                <hr>

                <h5 class="fw-bold mb-3">About this property</h5>
                <p class="text-muted property-description">
                    <%= listing.description %>
                </p>

                <hr>

                <h5 class="fw-bold mb-3">Property Location</h5>

                <p class="text-muted mb-2">
                    <i class="fa-solid fa-location-dot text-danger me-2"></i>
                    <%= listing.location %>, <%= listing.country %>
                </p>

            </div>

            <!-- Reviews Section -->
            <div class="property-info-card p-4">

                <h4 class="fw-bold mb-4">
                    <i class="fa-solid fa-star text-warning me-2"></i>
                    Guest Reviews
                    <span class="text-muted fs-6">
                        (<%= listing.reviews.length %>)
                    </span>
                </h4>

                <% if(currUser) { %>

                    <div class="review-form-box p-3 p-md-4 mb-4">

                        <h5 class="fw-bold mb-3">Share Your Experience</h5>

                        <form action="/listings/<%= listing._id %>/reviews"
                              method="POST"
                              novalidate
                              class="needs-validation">

                            <div class="mb-3">
                                <label class="form-label fw-semibold">Your Rating</label>

                                <fieldset class="starability-slot">
                                    <input type="radio" id="no-rate"
                                           class="input-no-rate"
                                           name="review[rating]"
                                           value="0" checked
                                           aria-label="No rating." />

                                    <input type="radio" id="first-rate1"
                                           name="review[rating]" value="1" />
                                    <label for="first-rate1" title="Terrible">1 star</label>

                                    <input type="radio" id="first-rate2"
                                           name="review[rating]" value="2" />
                                    <label for="first-rate2" title="Not good">2 stars</label>

                                    <input type="radio" id="first-rate3"
                                           name="review[rating]" value="3" />
                                    <label for="first-rate3" title="Average">3 stars</label>

                                    <input type="radio" id="first-rate4"
                                           name="review[rating]" value="4" />
                                    <label for="first-rate4" title="Very good">4 stars</label>

                                    <input type="radio" id="first-rate5"
                                           name="review[rating]" value="5" />
                                    <label for="first-rate5" title="Amazing">5 stars</label>
                                </fieldset>
                            </div>

                            <div class="mb-3">
                                <label for="comment" class="form-label fw-semibold">
                                    Your Comments
                                </label>

                                <textarea name="review[comment]"
                                          id="comment"
                                          rows="4"
                                          class="form-control review-textarea"
                                          placeholder="Tell others about your experience..."
                                          required></textarea>

                                <div class="invalid-feedback">
                                    Please add comments for your review.
                                </div>
                            </div>

                            <button class="btn btn-success rounded-pill px-4">
                                <i class="fa-solid fa-paper-plane me-2"></i>
                                Submit Review
                            </button>

                        </form>
                    </div>

                <% } else { %>

                    <div class="login-review-box p-3 mb-4">
                        <p class="mb-0 text-muted">
                            <a href="/login" class="text-success fw-bold">Login</a>
                            to share your experience and write a review.
                        </p>
                    </div>

                <% } %>

                <!-- Existing Reviews -->
                <% if(listing.reviews.length > 0) { %>

                    <div class="row g-3">

                        <% for(let review of listing.reviews) { %>

                            <div class="col-md-6">

                                <div class="review-card h-100 p-3">

                                    <div class="d-flex align-items-center gap-3 mb-3">

                                        <div class="review-avatar">
                                            <i class="fa-solid fa-user"></i>
                                        </div>

                                        <div>
                                            <h6 class="fw-bold mb-0">
                                                @<%= review.author.username %>
                                            </h6>
                                            <small class="text-muted">Guest Review</small>
                                        </div>

                                    </div>

                                    <p class="starability-result mb-2"
                                       data-rating="<%= review.rating %>">
                                    </p>

                                    <p class="text-muted mb-3">
                                        <%= review.comment %>
                                    </p>

                                    <% if(currUser && review.author._id.equals(currUser._id)) { %>

                                        <form method="POST"
                                              action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">

                                            <button class="btn btn-sm btn-outline-danger rounded-pill px-3">
                                                <i class="fa-solid fa-trash me-1"></i>
                                                Delete Review
                                            </button>

                                        </form>

                                    <% } %>

                                </div>

                            </div>

                        <% } %>

                    </div>

                <% } else { %>

                    <div class="text-center py-4">
                        <i class="fa-regular fa-comment-dots fa-3x text-muted mb-3"></i>
                        <h5 class="fw-bold">No Reviews Yet</h5>
                        <p class="text-muted mb-0">
                            Be the first guest to share your experience!
                        </p>
                    </div>

                <% } %>

            </div>

        </div>

        <!-- Price Card -->
        <div class="col-lg-4">

            <div class="price-card p-4">

                <p class="text-muted mb-2">Your Stay Price</p>

                <h3 class="fw-bold mb-1">
                    ₹ <%= listing.price.toLocaleString("en-IN") %>
                    <span class="fs-6 text-muted fw-normal">/ night</span>
                </h3>

                <hr>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Property</span>
                    <span class="fw-semibold">StayScape</span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Location</span>
                    <span class="fw-semibold text-end">
                        <%= listing.country %>
                    </span>
                </div>

                <div class="d-flex justify-content-between mb-3">
                    <span class="text-muted">Hosted by</span>
                    <span class="fw-semibold">
                        <%= listing.owner.username %>
                    </span>
                </div>

                <hr>

                <a href="#map-section"
                   class="btn btn-success rounded-pill w-100">
                    <i class="fa-solid fa-map-location-dot me-2"></i>
                    View Location
                </a>

                <p class="text-muted small text-center mt-3 mb-0">
                    Discover your next memorable stay.
                </p>

            </div>

        </div>

    </div>

    <!-- Map Section -->
    <div class="property-info-card p-4 mt-4" id="map-section">

        <h4 class="fw-bold mb-2">Where you'll be</h4>

        <p class="text-muted mb-4">
            Explore the location of <%= listing.title %>.
        </p>

        <div id="map"></div>

    </div>

</div>

<!-- Map Script -->
<script src="/js/map.js"></script>