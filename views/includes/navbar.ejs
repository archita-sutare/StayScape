<nav class="navbar navbar-expand-lg stayscape-navbar sticky-top">
    <div class="container-fluid px-lg-4">

        <!-- Brand -->
        <a class="navbar-brand stayscape-brand" href="/">
            <i class="fa-regular fa-compass"></i>
            StayScape
        </a>

        <!-- Mobile Toggle -->
        <button class="navbar-toggler" type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarNavAltMarkup"
            aria-controls="navbarNavAltMarkup"
            aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarNavAltMarkup">

            <!-- Explore -->
            <div class="navbar-nav ms-lg-4">
                <a class="nav-link" href="/listings">
                    <i class="fa-solid fa-compass me-1"></i>
                    Explore
                </a>
            </div>

            <!-- Search -->
            <div class="navbar-nav mx-lg-auto my-3 my-lg-0">
                <form class="d-flex stayscape-search"
                    role="search"
                    action="/listings"
                    method="GET">

                    <input
                        class="form-control search-input"
                        type="search"
                        placeholder="Search country, city or stay"
                        name="search"
                    />

                    <button class="btn btn-search" type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search
                    </button>
                </form>
            </div>

            <!-- Navigation Actions -->
            <div class="navbar-nav ms-lg-auto align-items-lg-center">

                <a class="nav-link" href="/listings/new">
                    <i class="fa-solid fa-house me-1"></i>
                    StayScape your home
                </a>

                <% if(currUser && currUser.role === "host") { %>
                    <a class="nav-link" href="/host/dashboard">
                        <i class="fa-solid fa-gauge-high me-1"></i>
                        Host Dashboard
                    </a>
                <% } %>

                <% if(!currUser) { %>
                    <a class="nav-link" href="/signup">
                        <i class="fa-solid fa-user-plus me-1"></i>
                        SignUp
                    </a>

                    <a class="nav-link login-btn" href="/login">
                        Login
                    </a>
                <% } %>

                <% if(currUser) { %>
                    <a class="nav-link logout-btn" href="/logout">
                        <i class="fa-solid fa-right-from-bracket me-1"></i>
                        Logout
                    </a>
                <% } %>

            </div>
        </div>
    </div>
</nav>

