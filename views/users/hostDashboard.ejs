
<% layout("/layouts/boilerplate") %>

<div class="container mt-4">
    <h2>Welcome to StayScape, Host!</h2>
    <p class="text-muted">Manage your properties from here.</p>

    <div class="row mt-4">
        <div class="col-md-6 mb-3">
            <div class="card p-4">
                <h4>My Listings</h4>
                <p>View and manage your properties.</p>
                <a href="/listings" class="btn btn-outline-success">
                    View Listings
                </a>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card p-4">
                <h4>Add New Listing</h4>
                <p>Publish your property on StayScape.</p>
                <a href="/listings/new" class="btn btn-success">
                    Add Listing
                </a>
            </div>
        </div>
    </div>
</div>
